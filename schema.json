components:
  schemas:
    AddBadge:
      type: object
      properties:
        name:
          type: string
        description:
          type: string
      required:
      - description
      - name
    AddJournal:
      type: object
      properties:
        title:
          type: string
        transaction_id:
          type: string
        feel:
          $ref: '#/components/schemas/FeelEnum'
        mistakes:
          type: string
        lesson_learned:
          type: string
        followed_plan:
          type: boolean
      required:
      - feel
      - followed_plan
      - lesson_learned
      - mistakes
      - title
      - transaction_id
    AddPortfolio:
      type: object
      properties:
        name:
          type: string
        broker:
          type: string
        balance:
          type: string
          format: decimal
          pattern: ^-?\d{0,13}(?:\.\d{0,2})?$
        currency:
          $ref: '#/components/schemas/CurrencyEnum'
        leverage:
          $ref: '#/components/schemas/LeverageEnum'
      required:
      - balance
      - broker
      - currency
      - leverage
      - name
    CurrencyEnum:
      enum:
      - USD
      - USDT
      - EUR
      - IRR
      type: string
      description: |-
        * `USD` - USD
        * `USDT` - USDT
        * `EUR` - EUR
        * `IRR` - IRR
    EditRiskManage:
      type: object
      properties:
        max_risk:
          type: string
        max_loss_daily:
          type: string
        max_loss_weekly:
          type: string
        max_transaction_daily:
          type: string
        max_consecutive_loss:
          type: string
